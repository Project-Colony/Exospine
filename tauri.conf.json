{
  "productName": "Exospine",
  "identifier": "com.mothersphere.exospine",
  "build": {
    "frontendDist": "assets/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Exospine",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost https:; frame-src 'self' blob: data:"
    }
  },
  "bundle": {
    "icon": [
      "assets/icons/icon.png",
      "assets/icons/32x32.png",
      "assets/icons/128x128.png",
      "assets/icons/128x128@2x.png",
      "assets/icons/icon.icns",
      "assets/icons/icon.ico"
    ]
  }
}
